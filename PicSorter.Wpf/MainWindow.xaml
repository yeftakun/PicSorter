<Window x:Class="PicSorter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PicSorter.Wpf"
        xmlns:views="clr-namespace:PicSorter.Wpf.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="PicSorter" Height="740" Width="1100"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Padding="12,8">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Source folder -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Source:" VerticalAlignment="Center" Width="55" FontWeight="Medium"/>
                    <ui:TextBox Text="{Binding SourceFolder}" Width="420" Margin="0,0,8,0" PlaceholderText="Pilih folder sumber..."/>
                    <ui:Button Content="Browse..." Command="{Binding BrowseSourceCommand}" Width="90"/>
                </StackPanel>

                <!-- Row 2: Options + Actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mode selector + visual indicator -->
                    <TextBlock Text="Mode:" VerticalAlignment="Center" Width="45" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="80" Margin="0,0,8,0"/>
                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMode}" Value="Move">
                                        <Setter Property="Background" Value="#CC3600"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="COPY — aman"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Move">
                                            <Setter Property="Text" Value="⚠ MOVE — destruktif!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Separator Width="1" Height="20" Margin="0,0,10,0"/>

                    <!-- Sort options -->
                    <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding SortCriteriaOptions}" SelectedItem="{Binding SelectedSortCriteria}" Width="110" Margin="0,0,8,0"/>
                    <CheckBox Content="Subfolders" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Separator Width="1" Height="20" Margin="0,0,10,0"/>

                    <!-- Action buttons -->
                    <ui:Button Content="Start Sorting" Command="{Binding StartSortingCommand}" Margin="0,0,6,0" Appearance="Primary"/>
                    <ui:Button Content="Continue" Command="{Binding ContinueFromLogCommand}" Margin="0,0,6,0"/>
                    <ui:Button Content="Save / Apply" Command="{Binding SavePlanCommand}" Margin="0,0,14,0"/>

                    <Separator Width="1" Height="20" Margin="0,0,10,0"/>

                    <!-- Destination quick buttons -->
                    <TextBlock Text="Dest:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Medium"/>
                    <ui:Button Content="Add" Command="{Binding AddDestinationCommand}" Width="55" Margin="0,0,5,0"/>
                    <ui:Button Content="Clear" Command="{Binding ClearDestinationsCommand}" Width="55"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- PREVIEW (swappable UserControl — SinglePreviewView / GridPreviewView) -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1" Margin="10" CornerRadius="4" ClipToBounds="True">
                <views:SinglePreviewView/>
            </Border>

            <!-- PANEL INFO (Kanan) -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Destinations -->
                        <TextBlock Text="Destinations" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <ListView ItemsSource="{Binding Destinations}" Height="180" Margin="0,0,0,16"
                                  BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Key" DisplayMemberBinding="{Binding Shortcut}" Width="40"/>
                                    <GridViewColumn Header="Folder" DisplayMemberBinding="{Binding FolderPath}" Width="200"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- EXIF Metadata -->
                        <TextBlock Text="EXIF Metadata" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding CurrentExif.DateTaken, StringFormat='Date: \{0\}', TargetNullValue='Date: —', FallbackValue='Date: —'}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentExif.CameraModel, StringFormat='Camera: \{0\}', TargetNullValue='Camera: —', FallbackValue='Camera: —'}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentExif.Resolution, StringFormat='Res: \{0\}', TargetNullValue='Res: —', FallbackValue='Res: —'}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Session Statistics -->
                        <TextBlock Text="Session Statistics" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SessionStatistics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}"
                             Width="130" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <Separator Grid.Column="2" Width="1" Height="14" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="3" Text="{Binding FileName}" VerticalAlignment="Center"
                           Margin="0,0,8,0" MaxWidth="280" TextTrimming="CharacterEllipsis"/>

                <!-- Duplicate InfoBadge -->
                <ui:InfoBadge Grid.Column="4"
                              Severity="Caution"
                              Value="DUP"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Visibility="{Binding IsCurrentFileDuplicate, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <!-- Shortcut legend -->
                <TextBlock Grid.Column="7" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"
                           Text="1-0: Assign  |  S: Skip  |  ⌫: Undo  |  ←/→: Browse"/>
            </Grid>
        </Border>

    </Grid>
</Window>
