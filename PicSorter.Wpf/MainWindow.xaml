<Window x:Class="PicSorter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PicSorter.Wpf"
        mc:Ignorable="d"
        Title="PicSorter WPF" Height="700" Width="1000"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10">
            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Source Folder:" VerticalAlignment="Center" Width="100"/>
                    <TextBox Text="{Binding SourceFolder}" Width="400" Margin="0,0,10,0"/>
                    <Button Content="Browse..." Command="{Binding BrowseSourceCommand}" Width="80"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Mode:" VerticalAlignment="Center" Width="100"/>
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="80" Margin="0,0,10,0"/>
                    
                    <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding SortCriteriaOptions}" SelectedItem="{Binding SelectedSortCriteria}" Width="110" Margin="0,0,15,0"/>
                    
                    <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <Button Content="Start Sorting" Command="{Binding StartSortingCommand}" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Continue" Command="{Binding ContinueFromLogCommand}" Width="80" Margin="0,0,10,0"/>
                    <Button Content="Save / Apply" Command="{Binding SavePlanCommand}" Width="90"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- PREVIEW -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Margin="10">
                <Grid>
                    <TextBlock Text="No Image" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    <Image x:Name="imgPreview" Stretch="Uniform"/>
                </Grid>
            </Border>

            <!-- PANEL INFO (Kanan) -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1,0,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Destinations" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add Dest" Command="{Binding AddDestinationCommand}" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Clear" Command="{Binding ClearDestinationsCommand}" Width="80"/>
                    </StackPanel>
                    
                    <ListView ItemsSource="{Binding Destinations}" Height="200" Margin="0,0,0,20">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Key" DisplayMemberBinding="{Binding Shortcut}" Width="50"/>
                                <GridViewColumn Header="Folder" DisplayMemberBinding="{Binding FolderPath}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Text="EXIF Metadata" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding CurrentExif.DateTaken, StringFormat='Date: \{0\}', TargetNullValue='Date: -', FallbackValue='Date: -'}" Foreground="DarkGray"/>
                        <TextBlock Text="{Binding CurrentExif.CameraModel, StringFormat='Camera: \{0\}', TargetNullValue='Camera: -', FallbackValue='Camera: -'}" Foreground="DarkGray"/>
                        <TextBlock Text="{Binding CurrentExif.Resolution, StringFormat='Resolution: \{0\}', TargetNullValue='Resolution: -', FallbackValue='Resolution: -'}" Foreground="DarkGray"/>
                    </StackPanel>

                    <TextBlock Text="Shortcuts Info" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="1-0: Assign to Destination&#x0a;S: Skip&#x0a;Backspace: Undo" Foreground="DarkGray" Margin="0,0,0,20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="2" Padding="5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Width="250"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding FileName}" Width="350"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMaximum}" Width="150" Height="15"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ProgressText}" Margin="10,0,0,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
